PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://user:password@localhost:5432/supplier_ops
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=shpss_xxx
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2026-01
APPLY_CHANGES=false
EMAIL_WEBHOOK_URL=
WEEKLY_SYNC_INTERVAL_MS=604800000

# BI Market Radar is free-first and uses public/source-safe inputs.
# Add public blogs/newsletters/RSS-style pages as comma-separated URLs.
MARKET_RADAR_SOURCE_URLS=
# JSON array of public competitor product pages to price-check.
COMPETITOR_PRICE_URLS=[]
# Optional official/API-safe social credentials. Do not add social passwords or cookies.
REDDIT_ACCESS_TOKEN=
META_ACCESS_TOKEN=
X_BEARER_TOKEN=
PINTEREST_ACCESS_TOKEN=
TRUTH_SOCIAL_APPROVED_ACCESS=false

# Feed adapters are preferred when a supplier can provide structured data.
# Physicians' Standard, DesBio, and Research Nutritionals have built-in public feed defaults.
# Set these only if you want to override the defaults:
# SUPPLIER_FEED_URL_PHYSICIANS_STANDARD=https://www.physiciansstandard.com/products.json?limit=250
# SUPPLIER_FEED_URL_DESBIO=https://desbio.com/wp-json/wc/store/v1/products?per_page=100
# SUPPLIER_FEED_URL_RESEARCH_NUTRITIONALS=https://www.researchednutritionals.com/wp-json/wc/store/v1/products?per_page=100

# Website adapters need portal settings as JSON plus username/password.
# Example:
# SUPPLIER_WEBSITE_CONFIG_DESBIO={"loginUrl":"https://portal.example.com/login","productsUrl":"https://portal.example.com/products","selectors":{"username":"#email","password":"#password","submit":"button[type=submit]","productRows":"[data-product-row]"}}
# SUPPLIER_USERNAME_DESBIO=portal-user
# SUPPLIER_PASSWORD_DESBIO=portal-password

# Physicians' Standard credentials can stay in Render for future authenticated cost/stock work,
# but the current public feed does not require them.
# SUPPLIER_WEBSITE_CONFIG_PHYSICIANS_STANDARD={"loginUrl":"https://portal.example.com/login","productsUrl":"https://portal.example.com/products","selectors":{"username":"#email","password":"#password","submit":"button[type=submit]","productRows":"[data-product-row]"}}
# SUPPLIER_USERNAME_PHYSICIANS_STANDARD=portal-user
# SUPPLIER_PASSWORD_PHYSICIANS_STANDARD=portal-password

# Emerson Ecologics uses its catalog page plus an optional captured cookie header from a logged-in session.
# Use `npm run capture:emerson` locally to avoid digging through browser Inspect manually.
# SUPPLIER_COOKIE_EMERSON_ECOLOGICS=session-cookie-string
# Optional: add more Emerson catalog/search URLs, comma-separated or newline-separated, to broaden coverage.
# SUPPLIER_CATALOG_URLS_EMERSON_ECOLOGICS=https://www.emersonecologics.com/shop,https://www.emersonecologics.com/shop?search=magnesium
#
# If Emerson provides an official feed/API URL later, prefer that with SUPPLIER_FEED_URL_EMERSON_ECOLOGICS.
# The login page uses bot protection, so credentials alone are not enough for reliable unattended automation.
# SUPPLIER_WEBSITE_CONFIG_EMERSON_ECOLOGICS={"loginUrl":"https://emersonecologics.com/login","productsUrl":"https://emersonecologics.com/<post-login-catalog-or-export-url>","selectors":{"username":"#email","password":"#password","submit":"button[data-e2e=\"sign-in-button\"], button[type=submit]","productRows":"[data-product-row]"}}
# SUPPLIER_USERNAME_EMERSON_ECOLOGICS=portal-user
# SUPPLIER_PASSWORD_EMERSON_ECOLOGICS=portal-password
