{% render 'lwt-int-v1-style-loader' %}

<section
  class="lwt-int lwt-int--{{ section.settings.tone }} lwt-int-band lwt-int-flow--{{ section.settings.flow_position }}"
  id="LWTIntProcess-{{ section.id }}"
>
  {% render 'lwt-int-v1-bg', section: section %}

  <div class="lwt-int__shell">
    <div class="lwt-int__section-head">
      <div>
        {% if section.settings.kicker != blank %}
          <p class="lwt-int__kicker">{{ section.settings.kicker | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="lwt-int__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.copy != blank %}
          <div class="lwt-int__copy">{{ section.settings.copy }}</div>
        {% endif %}
      </div>
    </div>

    <div class="lwt-int-process" style="--lwt-int-columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        <article class="lwt-int-process__step" {{ block.shopify_attributes }}>
          <span class="lwt-int-process__number">{{ forloop.index }}</span>
          {% if block.settings.title != blank %}
            <h3 class="lwt-int-process__title">{{ block.settings.title | escape }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="lwt-int-process__text">{{ block.settings.text | escape }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LWT Int Process",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "default": "dark",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "select",
      "id": "flow_position",
      "label": "Flow position",
      "default": "continuous",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "continuous", "label": "Continuous" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "bg_asset",
      "label": "Theme asset background",
      "info": "Use a theme asset filename from the provided mockup crops."
    },
    {
      "type": "text",
      "id": "bg_position",
      "label": "Background position",
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "Background size",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "100% auto", "label": "Full width" },
        { "value": "auto 100%", "label": "Full height" }
      ]
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A clearer path forward" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Use this compact process section for models, timelines, consult steps, or education flows.</p>" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Collect" },
        { "type": "text", "id": "text", "label": "Text", "default": "Start with the information that matters most." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWT Int Process",
      "blocks": [
        { "type": "step" },
        {
          "type": "step",
          "settings": {
            "title": "Analyze",
            "text": "Review patterns, goals, and areas of support."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Guide",
            "text": "Build a plan with practitioner context."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Support",
            "text": "Stay supported as your needs change."
          }
        }
      ]
    }
  ]
}
{% endschema %}
