{% render 'lwt-int-v1-style-loader' %}

<section
  class="lwt-int lwt-int--{{ section.settings.tone }} lwt-int-band lwt-int-flow--{{ section.settings.flow_position }}"
  id="LWTIntProof-{{ section.id }}"
>
  {% render 'lwt-int-v1-bg', section: section %}

  <div class="lwt-int__shell">
    {% if section.settings.heading != blank %}
      <div class="lwt-int__section-head">
        <div>
          {% if section.settings.kicker != blank %}
            <p class="lwt-int__kicker">{{ section.settings.kicker | escape }}</p>
          {% endif %}
          <h2 class="lwt-int__heading">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
    {% endif %}

    <div class="lwt-int-proof" style="--lwt-int-columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        <article class="lwt-int-proof__item" {{ block.shopify_attributes }}>
          <span class="lwt-int__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 3l7 4v5.8c0 4.5-2.9 7.5-7 8.2-4.1-.7-7-3.7-7-8.2V7l7-4z" stroke="currentColor" stroke-width="1.7"/>
              <path d="M8.5 12.2l2.2 2.2 5-5.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <div>
            {% if block.settings.title != blank %}
              <h3 class="lwt-int-proof__title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="lwt-int-proof__text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LWT Int Proof",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "default": "dark",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "select",
      "id": "flow_position",
      "label": "Flow position",
      "default": "continuous",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "continuous", "label": "Continuous" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "bg_asset",
      "label": "Theme asset background",
      "info": "Use a theme asset filename from the provided mockup crops."
    },
    {
      "type": "text",
      "id": "bg_position",
      "label": "Background position",
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "Background size",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "100% auto", "label": "Full width" },
        { "value": "auto 100%", "label": "Full height" }
      ]
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100
    },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Practitioner vetted" },
        { "type": "text", "id": "text", "label": "Text", "default": "Reviewed by our experienced clinical team." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWT Int Proof",
      "blocks": [
        { "type": "proof" },
        {
          "type": "proof",
          "settings": {
            "title": "Science-backed",
            "text": "Products and guidance grounded in trusted data."
          }
        },
        {
          "type": "proof",
          "settings": {
            "title": "Secure and private",
            "text": "Your information is protected with care."
          }
        },
        {
          "type": "proof",
          "settings": {
            "title": "Ongoing support",
            "text": "We help you every step of the way."
          }
        }
      ]
    }
  ]
}
{% endschema %}
