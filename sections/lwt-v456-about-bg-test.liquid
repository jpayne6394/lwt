{{ 'lwt-v456-about-bg-test.css' | asset_url | stylesheet_tag }}

<div class="lwt-v456-about-bg-test" aria-label="LWT V4.5.6 About approved background system Shopify smoke test">
  <section class="lwt-v456-about-bg-test__section lwt-v456-about-bg-test__section--dark" aria-label="Hero background">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ 'lwt-about-hero-mobile.png' | asset_url }}">
      <img src="{{ 'lwt-about-hero-desktop.png' | asset_url }}" alt="" width="1440" height="510">
    </picture>
    <div class="lwt-v456-about-bg-test__safe-zone" aria-hidden="true" style="--x: 8%; --y: 16%; --w: 36%; --h: 52%; --mx: 8%; --my: 12%; --mw: 84%; --mh: 34%;">Hero headline / copy / buttons</div>
    <div class="lwt-v456-about-bg-test__safe-zone" aria-hidden="true" style="--x: 58%; --y: 12%; --w: 32%; --h: 64%; --mx: 10%; --my: 55%; --mw: 80%; --mh: 32%;">Hero consult image / media</div>
  </section>

