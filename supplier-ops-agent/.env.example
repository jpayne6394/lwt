PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://user:password@localhost:5432/supplier_ops
SHOPIFY_API_KEY=your-shopify-client-id
SHOPIFY_API_SECRET=shpss_xxx
# Preferred Admin API names for LWT Intelligence Center.
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxx
# Existing Supplier Ops names are still supported.
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2026-01
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=lwt-intelligence-center/1.0
GOOGLE_TRENDS_PROVIDER_KEY=
SEARCH_PROVIDER_KEY=
SEARCH_PROVIDER_URL=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_JSON=
SEARCH_CONSOLE_SITE_URL=
SEARCH_CONSOLE_CREDENTIALS_JSON=
INTERNAL_DASHBOARD_PASSWORD=
INTERNAL_DASHBOARD_AUTH_REQUIRED=false
CONTENT_TOPICS_PATH=config/content_topics.json
CONTENT_RADAR_SOURCES_PATH=config/content-radar-sources.json
SHOPPER_BEHAVIOR_IMPORT_DIR=imports/shopper-behavior
EMAIL_WEBHOOK_URL=
WEEKLY_SYNC_INTERVAL_MS=604800000
MEMORY_PROVIDER=postgres
MEMORY_VECTOR_ENABLED=true
EMBEDDING_PROVIDER=local
LOCAL_LLM_RELAY_URL=
LOCAL_LLM_RELAY_TOKEN=
LOCAL_EMBEDDING_MODEL=auto
LOCAL_LLM_TIMEOUT_MS=15000
MEMORY_MAX_CONTEXT_CHARS=24000

# Feed adapters are preferred when a supplier can provide structured data.
# Example:
# SUPPLIER_FEED_URL_DESBIO=https://supplier.example.com/products.json

# Website adapters need portal settings as JSON plus username/password.
# Example:
# SUPPLIER_WEBSITE_CONFIG_DESBIO={"loginUrl":"https://portal.example.com/login","productsUrl":"https://portal.example.com/products","selectors":{"username":"#email","password":"#password","submit":"button[type=submit]","productRows":"[data-product-row]"}}
# SUPPLIER_USERNAME_DESBIO=portal-user
# SUPPLIER_PASSWORD_DESBIO=portal-password
