PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://user:password@localhost:5432/supplier_ops
SHOPIFY_SHOP=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2026-01
EMAIL_WEBHOOK_URL=
WEEKLY_SYNC_INTERVAL_MS=604800000

# Feed adapters are preferred when a supplier can provide structured data.
# Example:
# SUPPLIER_FEED_URL_DESBIO=https://supplier.example.com/products.json

# Website adapters need portal settings as JSON plus username/password.
# Example:
# SUPPLIER_WEBSITE_CONFIG_DESBIO={"loginUrl":"https://portal.example.com/login","productsUrl":"https://portal.example.com/products","selectors":{"username":"#email","password":"#password","submit":"button[type=submit]","productRows":"[data-product-row]"}}
# SUPPLIER_USERNAME_DESBIO=portal-user
# SUPPLIER_PASSWORD_DESBIO=portal-password

