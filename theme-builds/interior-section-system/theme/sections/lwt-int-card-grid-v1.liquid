{% render 'lwt-int-v1-style-loader' %}

<section
  class="lwt-int lwt-int--{{ section.settings.tone }} lwt-int-band lwt-int-flow--{{ section.settings.flow_position }}"
  id="LWTIntGrid-{{ section.id }}"
>
  {% render 'lwt-int-v1-bg', section: section %}

  <div class="lwt-int__shell">
    <div class="lwt-int__section-head">
      <div>
        {% if section.settings.kicker != blank %}
          <p class="lwt-int__kicker">{{ section.settings.kicker | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="lwt-int__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.copy != blank %}
          <div class="lwt-int__copy">{{ section.settings.copy }}</div>
        {% endif %}
      </div>

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="lwt-int__button lwt-int__button--secondary" href="{{ section.settings.link }}">
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </div>

    <div class="lwt-int-grid" style="--lwt-int-columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        <article class="lwt-int-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <span class="lwt-int-card__media">
              {{
                block.settings.image
                | image_url: width: 720
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 520, 720',
                  sizes: '(min-width: 990px) 33vw, 100vw'
              }}
            </span>
          {% else %}
            <span class="lwt-int__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 3l7 4v6c0 4.4-2.8 7.4-7 8-4.2-.6-7-3.6-7-8V7l7-4z" stroke="currentColor" stroke-width="1.7"/>
                <path d="M8.5 12l2.3 2.3 4.9-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="lwt-int-card__title">{{ block.settings.title | escape }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="lwt-int-card__text">{{ block.settings.text }}</div>
          {% endif %}

          {% if block.settings.link_label != blank and block.settings.link != blank %}
            <a class="lwt-int-card__link" href="{{ block.settings.link }}">
              {{ block.settings.link_label | escape }} &rarr;
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LWT Int Grid",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "dark", "label": "Dark" }
      ]
    },
    {
      "type": "select",
      "id": "flow_position",
      "label": "Flow position",
      "default": "middle",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "continuous", "label": "Continuous" },
        { "value": "none", "label": "None" }
      ]
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "bg_asset",
      "label": "Theme asset background",
      "info": "Use a theme asset filename from the provided mockup crops."
    },
    {
      "type": "text",
      "id": "bg_position",
      "label": "Background position",
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_size",
      "label": "Background size",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "100% auto", "label": "Full width" },
        { "value": "auto 100%", "label": "Full height" }
      ]
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help today?"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Use compact cards for interior pathways, support options, benefits, brands, or resources.</p>"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Header link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Header link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Book a wellness consult" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Get personalized guidance from experienced practitioners.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LWT Int Grid",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "title": "Product support",
            "text": "<p>Help with orders, products, shipping, and returns.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Visit us in Richmond",
            "text": "<p>Connect with our team in the heart of Richmond, VA.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "General questions",
            "text": "<p>Have a question? We are happy to help.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
